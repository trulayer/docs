#!/usr/bin/env bash
# pre-push: runs on every `git push`. Blocks the push on any failure.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() { echo "❌ $*" >&2; exit 1; }
step() { echo "▶ $*"; }

# Mintlify (mint broken-links) requires Node < 25. On Node 25+ the check is
# skipped locally and left to CI, which pins Node 22 via actions/setup-node.
NODE_MAJOR="$(node --version | sed 's/v\([0-9]*\).*/\1/')"
if [ "$NODE_MAJOR" -ge 25 ]; then
  echo "⚠️  Skipping broken-links locally: Mintlify does not support Node $NODE_MAJOR (CI runs Node 22 and will gate this check)."
else
  step "docs: broken link check"
  pnpm broken-links || fail "broken links found"
fi

echo "✅ pre-push checks passed"
